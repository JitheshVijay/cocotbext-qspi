# Interop against PicoSoC's spiflash.v -- an independently written model.
#
#   make -f Makefile.interop

TOPLEVEL_LANG ?= verilog
SIM ?= icarus

COCOTB_HDL_TIMEUNIT = 1ns
COCOTB_HDL_TIMEPRECISION = 1ps

# Its own build directory: the device suite's Makefile builds a different
# top level into sim_build/, and sharing one would make whichever ran
# first win -- exactly what CI does when it runs both.
SIM_BUILD = sim_build_interop

TOPLEVEL = tb_spiflash
MODULE   = test_interop

VERILOG_SOURCES  = $(shell pwd)/reference/spiflash.v
VERILOG_SOURCES += $(shell pwd)/reference/tb_spiflash.v

# spiflash.v loads its contents with $readmemh from +firmware=<file>.
# spiflash.v defaults to reading "firmware.hex" from the working
# directory; a plusarg path gets mangled by $value$plusargs here.
COCOTB_RESULTS_FILE = results.xml

export PYTHONPATH := $(shell pwd)/..:$(shell pwd):$(PYTHONPATH)
export COCOTB_HDL_TIMEUNIT
export COCOTB_HDL_TIMEPRECISION

include $(shell cocotb-config --makefiles)/Makefile.sim

# spiflash.v reads "firmware.hex" from the working directory. Hang the copy
# off results.xml as well as sim: Makefile.sim's default goal is results.xml,
# so a prerequisite on sim alone never fires.
sim results.xml: firmware.hex
firmware.hex: reference/firmware.hex
	cp $< $@

clean::
	@rm -rf sim_build_interop results.xml firmware.hex
